# Normalize source files in the repository; keep binary assets byte-for-byte.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.exe binary
*.zip binary
*.7z binary
*.pdf binary
