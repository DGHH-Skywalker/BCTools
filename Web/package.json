{
  "name": "xiaobo-frontend",
  "version": "5.6.0.0",
  "description": "小播点歌工具前端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/subset-fonts.cjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.vue",
    "lint:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@icon-park/vue-next": "^1.4.2",
    "axios": "^1.6.0",
    "bctools": "file:..",
    "dayjs": "^1.11.0",
    "dompurify": "^3.0.0",
    "jszip": "^3.10.0",
    "modern-screenshot": "^4.4.0",
    "naive-ui": "^2.38.0",
    "pinia": "^2.1.0",
    "segmentit": "^2.0.3",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.24.0",
    "fontmin": "^1.1.1",
    "jsdom": "^24.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.27.0",
    "vite": "^5.2.0",
    "vite-plugin-compression": "^0.5.0",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.0.0"
  }
}
